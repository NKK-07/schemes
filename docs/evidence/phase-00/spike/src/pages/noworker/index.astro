---
import Layout from "../../components/Layout.astro";
---
<Layout title="Pagefind main-thread fallback">
  <h1>No-worker search</h1>
  <p id="out">pending</p>
  <script>
    const out = document.getElementById("out")!;
    (async () => {
      try {
        const url = "/pagefind/pagefind.js";
        const pf = await import(/* @vite-ignore */ url);
        await pf.options({ noWorker: true });
        const r = await pf.search("prototype");
        const d = await Promise.all(r.results.map((x: { data: () => Promise<{ url: string }> }) => x.data()));
        out.textContent = "results: " + d.map((x) => x.url).join(",");
      } catch (e) {
        out.textContent = "error: " + String(e);
      }
    })();
  </script>
</Layout>
