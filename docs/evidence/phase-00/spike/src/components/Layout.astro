---
interface Props { title: string }
const { title } = Astro.props;
---
<!doctype html>
<html lang="en-IN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <script is:inline>document.documentElement.classList.add("js");try{var t=localStorage.getItem("ffg:theme");if(t){t=JSON.parse(t);if(t==="dark"||t==="light")document.documentElement.setAttribute("data-theme",t)}}catch(e){}</script>
    <style>.stamp{ -webkit-mask-image:url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='10' height='10'><rect width='10' height='10'/></svg>"); }</style>
  </head>
  <body><main id="main"><slot /></main></body>
</html>
